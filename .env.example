# Copie ce fichier en ".env" si tu veux activer le bonus Pappers.
# Le fichier .env est ignoré par Git (ne sera jamais publié).
#
# L'enrichissement SIREN fonctionne DÉJÀ gratuitement sans rien configurer
# (annuaire des entreprises officiel). La clé Pappers est OPTIONNELLE : elle
# ajoute seulement le capital et un CA détaillé.

# Clé API Pappers (optionnelle) — compte gratuit : https://www.pappers.fr/api
PAPPERS_API_TOKEN=

# Port du serveur (optionnel, défaut 3000)
# PORT=3000

# --- Authentification (déploiement en ligne) ---
# Si APP_PASSWORD est défini, l'app demande un identifiant + mot de passe à
# l'ouverture (Basic Auth). Laisse vide en local pour un accès direct.
# Identifiant (défaut : apothical)
# APP_USER=apothical
# Mot de passe partagé (à définir UNIQUEMENT en production, ex. sur Render)
# APP_PASSWORD=
